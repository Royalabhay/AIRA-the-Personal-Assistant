{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "User preferences and avatar customization",
      "type": "object",
      "properties": {
        "displayName": { "type": "string" },
        "avatarConfig": {
          "type": "object",
          "properties": {
            "outfit": { "type": "string" },
            "accessory": { "type": "string" }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["displayName", "createdAt"]
    },
    "Message": {
      "title": "Chat Message",
      "description": "A single message in a conversation",
      "type": "object",
      "properties": {
        "role": { "type": "string", "enum": ["user", "model"] },
        "content": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["role", "content", "timestamp"]
    },
    "Task": {
      "title": "Task",
      "description": "A task or reminder",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "completed"] },
        "priority": { "type": "string", "enum": ["low", "medium", "high"] },
        "recurrence": { "type": "string", "enum": ["none", "daily", "weekly", "monthly"] },
        "dueDate": { "type": "string", "format": "date-time" },
        "projectId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "status", "createdAt"]
    },
    "Project": {
      "title": "Project Folder",
      "description": "A conceptual folder for organizing tasks",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Storage for user profile and avatar settings"
    },
    "/users/{userId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Chat history for the user"
    },
    "/users/{userId}/projects/{projectId}": {
      "schema": "Project",
      "description": "Project folders created via chat"
    },
    "/users/{userId}/tasks/{taskId}": {
      "schema": "Task",
      "description": "Tasks associated with projects or general list"
    }
  }
}
