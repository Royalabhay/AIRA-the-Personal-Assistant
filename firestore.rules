rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Identifiers validation
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isVerified() {
      return request.auth.token.email_verified == true;
    }

    // User Profile
    match /users/{userId} {
      function isValidUser(data) {
        return data.keys().hasAll(['displayName', 'createdAt']) &&
               data.displayName is string && data.displayName.size() <= 100 &&
               data.createdAt == request.time;
      }

      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'avatarConfig'])
      );

      // Chat Messages
      match /messages/{messageId} {
        function isValidMessage(data) {
          return data.keys().hasAll(['role', 'content', 'timestamp']) &&
                 data.role in ['user', 'model'] &&
                 data.content is string && data.content.size() <= 10000 &&
                 data.timestamp == request.time;
        }

        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidMessage(request.resource.data);
      }

      // Projects
      match /projects/{projectId} {
        function isValidProject(data) {
          return data.keys().hasAll(['name', 'createdAt']) &&
                 data.name is string && data.name.size() <= 200 &&
                 data.createdAt == request.time;
        }

        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidProject(request.resource.data);
        allow update: if isOwner(userId) && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'description'])
        );
        allow delete: if isOwner(userId);
      }

      // Tasks
      match /tasks/{taskId} {
        function isValidTask(data) {
          return data.keys().hasAll(['title', 'status', 'createdAt']) &&
                 data.title is string && data.title.size() <= 500 &&
                 data.status in ['pending', 'completed'] &&
                 data.createdAt == request.time;
        }

        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidTask(request.resource.data);
        allow update: if isOwner(userId) && (
          request.resource.data.diff(resource.data).affectedKeys().hasSome(['title', 'description', 'status', 'dueDate', 'projectId', 'priority', 'recurrence'])
        );
        allow delete: if isOwner(userId);
      }
    }
  }
}
